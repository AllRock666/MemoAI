# ── Required ──────────────────────────────────────────────────────────────────
# Get your free key at https://console.groq.com → API Keys
GROQ_API_KEY=gsk_your_key_here

# ── Telegram Alerts (optional but recommended for demo) ───────────────────────
# 1. Message @BotFather on Telegram → /newbot → copy token
# 2. Message your bot once, then GET https://api.telegram.org/bot<TOKEN>/getUpdates
#    to find your chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── n8n webhooks ──────────────────────────────────────────────────────────────
N8N_BASE_URL=http://localhost:5678/webhook

# ── ChromaDB ─────────────────────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8000

# ── Data storage ──────────────────────────────────────────────────────────────
# Path for SQLite session database (relative to backend directory)
DATA_DB_PATH=./patient_data.db

# ── Backend (for OpenClaw agent) ─────────────────────────────────────────────
BACKEND_URL=http://localhost:8080
